# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Bucket Pattern Optimized)
MONGODB_URI=mongodb://localhost:27017/fleetdash

# Worker Threads Pool Configuration
WORKER_POOL_SIZE=4

# MongoDB Bucket Pattern Configuration
# One bucket = one vehicle for one clock hour (UTC). This is the safety cap of readings per bucket:
# a vehicle that sends more in one hour gets another bucket for that hour (default: 1000)
BUCKET_MAX_SIZE=1000

# Set to false to silence per-request logging (use for load tests)
LOG_REQUESTS=true

# How long (ms) the server waits to group readings before one database write
FLUSH_INTERVAL_MS=10

# Redis connection (Memurai or Redis)
REDIS_URL=redis://127.0.0.1:6379

# Redis mode: "single" (one Redis server at REDIS_URL, default) or "cluster" (a Redis Cluster)
REDIS_MODE=single

# Only for REDIS_MODE=cluster: start nodes as host:port, separated by commas.
# Leave empty to use the Docker Compose cluster on this PC (127.0.0.1, ports 7001 to 7003).
REDIS_CLUSTER_NODES=

# Only for REDIS_MODE=cluster: "docker-host" translates the Docker-internal node addresses of the Compose cluster
# to 127.0.0.1:7001...7006 (needed when the backend runs on your PC); "none" uses the addresses as announced.
# Leave empty to choose automatically (docker-host when REDIS_CLUSTER_NODES is empty, otherwise none).
REDIS_CLUSTER_NAT=

# Browser origin allowed to connect to Socket.io (* is fine for development)
CORS_ORIGIN=*

# How often (ms) live updates are collected and sent to clients as one binary message
BROADCAST_INTERVAL_MS=100

# How often (ms) the server reloads the active geofences from the database
GEOFENCE_REFRESH_MS=5000

# Largest number of readings accepted in one /ingest-batch request
MAX_BATCH_SIZE=5000

# Log detail: debug, info, warn, error or silent (default: info)
LOG_LEVEL=info